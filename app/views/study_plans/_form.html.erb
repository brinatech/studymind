
<%= form_with model: study_plan, class: "flex flex-col gap-2.5",
  data: { controller: "submit-lock",
      action: "turbo:submit-start->submit-lock#lock turbo:submit-end->submit-lock#unlock" } do |f| %>
  <div>
    <label class="field <%= 'field-error' if study_plan.errors[:objective].any? %>">
      <span class="label"><%= StudyPlan.human_attribute_name(:objective) %></span>
      <%= f.text_area :objective, rows: 2, maxlength: StudyPlan::MAX_OBJECTIVE_LENGTH,
            placeholder: "Ex.: aprender SQL do zero", class: "field-input resize-none" %>
    </label>
    <% study_plan.errors[:objective].each do |message| %><p class="field-msg"><%= message %></p><% end %>
  </div>

  <div>
    <label class="field <%= 'field-error' if study_plan.errors[:current_level].any? %>">
      <span class="label"><%= StudyPlan.human_attribute_name(:current_level) %></span>
      <%= f.select :current_level, StudyPlan::LEVELS.map { |level| [level_label(level), level] },
            { include_blank: "Selecione" }, class: "field-input" %>
    </label>
    <% study_plan.errors[:current_level].each do |message| %><p class="field-msg"><%= message %></p><% end %>
  </div>

  <div>
    <label class="field <%= 'field-error' if study_plan.errors[:deadline].any? %>">
      <span class="label"><%= StudyPlan.human_attribute_name(:deadline) %></span>
      <%= f.date_field :deadline, min: Date.tomorrow,
            max: StudyPlan::MAX_WEEKS.weeks.from_now.to_date, class: "field-input" %>
    </label>
    <% study_plan.errors[:deadline].each do |message| %><p class="field-msg"><%= message %></p><% end %>
  </div>

  <div>
    <label class="field <%= 'field-error' if study_plan.errors[:daily_hours].any? %>">
      <span class="label"><%= StudyPlan.human_attribute_name(:daily_hours) %></span>
      <%= f.number_field :daily_hours, min: 0.5, max: StudyPlan::MAX_DAILY_HOURS, step: 0.5,
            placeholder: "1,5", class: "field-input" %>
    </label>
    <% study_plan.errors[:daily_hours].each do |message| %><p class="field-msg"><%= message %></p><% end %>
  </div>

  <div>
    <legend class="label mb-1.5 mt-1"><%= StudyPlan.human_attribute_name(:available_days) %></legend>
    <div class="flex gap-1.5">
      <%= f.collection_check_boxes :available_days, StudyPlan::WEEKDAYS, :itself, ->(day) { weekday_short(day) } do |b| %>
          <span class="relative flex min-w-0 flex-1">
            <%= b.check_box class: "peer sr-only" %>
            <%= b.label(class: "day-pill w-full") { b.text } %>
          </span>
      <% end %>
    </div>
    <% study_plan.errors[:available_days].each do |message| %><p class="field-msg"><%= message %></p><% end %>
  </div>

  <div>
    <label class="field <%= 'field-error' if study_plan.errors[:goal].any? %>">
      <span class="label"><%= StudyPlan.human_attribute_name(:goal) %></span>
      <%= f.text_area :goal, rows: 2, maxlength: StudyPlan::MAX_GOAL_LENGTH,
            placeholder: "Ex.: escrever consultas com JOIN", class: "field-input resize-none" %>
    </label>
    <% study_plan.errors[:goal].each do |message| %><p class="field-msg"><%= message %></p><% end %>
  </div>

  <%= f.button type: :submit, class: "btn-primary mt-1.5", data: { submit_lock_target: "button" } do %>
    <span class="hidden size-4 animate-spin rounded-full border-[3px] border-mark/40 border-t-mark"
          data-submit-lock-target="spinner" aria-hidden="true"></span>
    <span data-submit-lock-target="label">Gerar plano</span>
  <% end %>
<% end %>
